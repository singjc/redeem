# syntax=docker/dockerfile:1

ARG UV_VERSION=0.12.11
ARG PYTHON_VERSION=3.12
ARG RDKIT_VERSION=2025.9.4

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

ARG RDKIT_VERSION

RUN apt-get -o Acquire::Retries=5 update && \
    apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        ca-certificates \
        libgomp1 \
        libstdc++6 && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /uvx /usr/local/bin/

ENV VIRTUAL_ENV=/opt/redeem/venv
ENV PATH="${VIRTUAL_ENV}/bin:/opt/redeem/bin:${PATH}"
ENV PYTHONUNBUFFERED=1
ENV OMP_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1
ENV MKL_NUM_THREADS=1

RUN --mount=type=cache,target=/root/.cache/uv \
    uv venv --python /usr/local/bin/python "${VIRTUAL_ENV}" && \
    uv pip install --python "${VIRTUAL_ENV}/bin/python" \
        "rdkit==${RDKIT_VERSION}" && \
    uv pip check --python "${VIRTUAL_ENV}/bin/python"

WORKDIR /work

COPY redeem/scripts/structure_signal_stage_b_probe_v1.py \
    /opt/redeem/bin/structure_signal_stage_b_probe_v1.py
COPY redeem/scripts/structure_signal_stage_b_full_v1.py \
    /opt/redeem/bin/structure_signal_stage_b_full_v1.py
COPY redeem/scripts/test_structure_signal_stage_b_full_v1.py \
    /opt/redeem/bin/test_structure_signal_stage_b_full_v1.py

RUN chmod 0755 /opt/redeem/bin/*.py && \
    python -c 'import rdkit; print("rdkit_version=" + rdkit.__version__)' && \
    structure_signal_stage_b_probe_v1.py --self-test && \
    structure_signal_stage_b_full_v1.py --self-test && \
    python /opt/redeem/bin/test_structure_signal_stage_b_full_v1.py

LABEL org.opencontainers.image.title="ReDeeM Stage B full ETKDG structure descriptors"
LABEL org.opencontainers.image.description="Frozen TRAIN-only 8k ETKDG descriptor generation; no force-field minimization; no CCS labels"
